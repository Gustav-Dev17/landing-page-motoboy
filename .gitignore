# Arquivos de configuração local (não versionar dados sensíveis)
# O .env é gerado automaticamente a partir do .env.example durante o build

# Variáveis de ambiente (não versionar dados sensíveis)
.env
.env.local
.env.*.local

# Node modules (se usar npm)
node_modules/
package-lock.json

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Editores
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*

# Temporários
*.tmp
.cache/

